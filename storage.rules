rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Each user reads/writes only objects under their own users/{uid}/ prefix.
    // The Cloud Function runs with admin credentials and is unaffected by this rule.
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
