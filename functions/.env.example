# Copy this to `.env` (committed to git OK) or `.env.<projectId>` (gitignored,
# for per-project secrets) and edit the values before `firebase deploy`.
#
# Both prefixes must match the paths the client app passes to
# `FirebaseCloudStorage(firestorePath: ..., storagePath: ...)`.
#
# Storage layout the function expects (flat):
#   {STORAGE_PREFIX}/{nodeId}.{ext}          — original bytes
#   {STORAGE_PREFIX}/thumbs/{nodeId}.jpg     — written by the function
#   {STORAGE_PREFIX}/previews/{nodeId}.jpg   — written by the function
#
# Firestore doc the function updates:
#   {FIRESTORE_PREFIX}/{nodeId}              — writes thumbnailUrl / previewUrl
#
# Single-tenant example:
#   STORAGE_PREFIX=files
#   FIRESTORE_PREFIX=files
#
# Per-user scoping example:
#   STORAGE_PREFIX=users/abcDEFghi123/blobs
#   FIRESTORE_PREFIX=users/abcDEFghi123/nodes
#
# Multi-tenant apps deploy one function per tenant, or fork the trigger to
# extract the tenant from the storage path and derive the Firestore path.

STORAGE_PREFIX=files
FIRESTORE_PREFIX=files
