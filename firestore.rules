rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user owns the nodes under /users/{uid}/nodes/*.
    // Access control beyond ownership (sharing, roles, org scoping) is
    // intentionally out of scope for this package — layer your own logic
    // on top if you need it.
    match /users/{uid}/nodes/{nodeId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
